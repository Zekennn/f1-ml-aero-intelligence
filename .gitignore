# =========================================================
# Only the website (web/) and the code that builds its data are published.
# Python runs on your computer only: its outputs (web/data/*.json,
# web/public/data/**, models/MODEL_REPORT.md) are committed; its inputs,
# caches and environments are not.
# =========================================================

# Python
venv/
.venv/
__pycache__/
*.pyc
models/*.pkl

# FastF1 download caches (rebuilt automatically by FastF1, hundreds of MB)
cache/
data/cache/
*.ff1pkl
fastf1_http_cache.sqlite

# Raw data repos (TracingInsights) - local only, never published
data/sources/

# Raw training data, regenerated by run.ps1 (backend/generate_dataset.py, fetch_real_data.py)
data/aero_dataset.csv
data/real_2026_data.csv
data/driver_performance_*.csv

# Node / Next.js
node_modules/
.next/
out/
*.tsbuildinfo
.vercel/

# Environment files and logs
.env
.env*.local
*.log

# Design references and temporary files
design-reference/
docs/reference/
*.tmp
*.bak
*.zip

# OS
.DS_Store
Thumbs.db
desktop.ini
